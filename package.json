  },
  "files": ["extensions/", "examples/", "scripts/", "docs/", "README.md", "README_EN.md"],
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*"
